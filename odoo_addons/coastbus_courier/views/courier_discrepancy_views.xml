<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_courier_discrepancy_tree" model="ir.ui.view">
        <field name="name">courier.discrepancy.tree</field>
        <field name="model">courier.discrepancy</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status in ('open', 'vehicle_search')" decoration-success="status == 'recovered'">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="kind"/>
                <field name="waybill_id"/>
                <field name="manifest_id"/>
                <field name="vehicle_id"/>
                <field name="responsible_driver_id"/>
                <field name="liability"/>
                <field name="missing_pieces"/>
                <field name="claim_amount" sum="Total"/>
                <field name="status" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_courier_discrepancy_form" model="ir.ui.view">
        <field name="name">courier.discrepancy.form</field>
        <field name="model">courier.discrepancy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_vehicle_search" type="object" string="Vehicle sweep" invisible="status != 'open'"/>
                    <button name="action_recovered" type="object" string="Parcel found" class="btn-primary" invisible="status not in ('open', 'vehicle_search')"/>
                    <button name="action_confirm_loss" type="object" string="Confirm loss" invisible="status not in ('open', 'vehicle_search')"
                            confirm="Confirm this parcel as lost? With liability on the driver, a liability entry is posted (if accounts are set)."
                            groups="coastbus_courier.group_courier_manager"/>
                    <button name="action_written_off" type="object" string="Claim paid / write off" invisible="status != 'loss_confirmed'"
                            groups="coastbus_courier.group_courier_manager"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,vehicle_search,recovered,loss_confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1><field name="kind"/></div>
                    <group>
                        <group string="Parcel">
                            <field name="waybill_id"/>
                            <field name="missing_pieces"/>
                            <field name="origin_hub_id"/>
                            <field name="destination_hub_id"/>
                            <field name="station_hub_id"/>
                            <field name="declared_value"/>
                        </group>
                        <group string="Custody">
                            <field name="manifest_id"/>
                            <field name="vehicle_id"/>
                            <field name="responsible_driver_id"/>
                            <field name="loaded_scan_at"/>
                            <field name="loaded_by_id"/>
                            <field name="driver_ack"/>
                            <field name="supervisor_id"/>
                        </group>
                        <group string="Outcome">
                            <field name="liability"/>
                            <field name="claim_amount"/>
                            <field name="liability_move_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Driver statement"><field name="driver_statement" nolabel="1" colspan="2"/></group>
                    <group string="Findings"><field name="investigation_notes" nolabel="1" colspan="2"/></group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_courier_discrepancy_search" model="ir.ui.view">
        <field name="name">courier.discrepancy.search</field>
        <field name="model">courier.discrepancy</field>
        <field name="arch" type="xml">
            <search>
                <field name="waybill_id"/>
                <field name="responsible_driver_id"/>
                <field name="vehicle_id"/>
                <filter name="open" string="Open" domain="[('status', 'in', ('open', 'vehicle_search'))]"/>
                <group expand="0" string="Group by">
                    <filter name="g_driver" string="Driver" context="{'group_by': 'responsible_driver_id'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_courier_discrepancy" model="ir.actions.act_window">
        <field name="name">Shortages &amp; losses</field>
        <field name="res_model">courier.discrepancy</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No shortages</p><p>When offloading does not match loading, an investigation opens here automatically.</p></field>
    </record>
</odoo>
