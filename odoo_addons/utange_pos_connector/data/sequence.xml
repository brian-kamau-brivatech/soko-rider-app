<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_requisition" model="ir.sequence">
            <field name="name">Bar requisition</field>
            <field name="code">utange.requisition</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_stock_sheet" model="ir.sequence">
            <field name="name">Shift stock sheet</field>
            <field name="code">utange.stock.sheet</field>
            <field name="prefix">SHEET/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
