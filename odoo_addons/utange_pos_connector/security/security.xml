<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sheet_company" model="ir.rule">
        <field name="name">Stock sheets: own companies</field>
        <field name="model_id" ref="model_utange_stock_sheet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_requisition_company" model="ir.rule">
        <field name="name">Requisitions: own companies</field>
        <field name="model_id" ref="model_utange_requisition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
