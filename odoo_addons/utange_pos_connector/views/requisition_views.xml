<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_requisition_tree" model="ir.ui.view">
        <field name="name">utange.requisition.tree</field>
        <field name="model">utange.requisition</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'submitted'" decoration-muted="state in ('rejected', 'cancel')">
                <field name="name"/>
                <field name="date"/>
                <field name="config_id"/>
                <field name="employee_id"/>
                <field name="point"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
                <field name="item_count" string="Items"/>
                <field name="picking_id" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'submitted'" decoration-info="state == 'approved'"
                       decoration-success="state == 'done'" decoration-danger="state == 'rejected'"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_requisition_form" model="ir.ui.view">
        <field name="name">utange.requisition.form</field>
        <field name="model">utange.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve and create transfer" class="btn-primary"
                            invisible="state != 'submitted'" groups="point_of_sale.group_pos_manager,stock.group_stock_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted', 'approved')"
                            groups="point_of_sale.group_pos_manager,stock.group_stock_manager"
                            confirm="Reject this requisition?"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <field name="picking_id" widget="statinfo" string="Transfer"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="config_id" readonly="state != 'submitted'"/>
                            <field name="employee_id"/>
                            <field name="session_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="point" readonly="state != 'submitted'"/>
                            <field name="location_src_id" readonly="state != 'submitted'"/>
                            <field name="location_dest_id" readonly="state != 'submitted'"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="line_ids" readonly="state != 'submitted'">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="bar_qty" optional="show"/>
                                    <field name="store_qty" optional="show"/>
                                    <field name="qty_issued"/>
                                    <field name="note" optional="show"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="note"/>
                        <field name="manager_note"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_requisition_search" model="ir.ui.view">
        <field name="name">utange.requisition.search</field>
        <field name="model">utange.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="config_id"/>
                <field name="line_ids" string="Item" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="to_approve" string="To approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="to_issue" string="To issue" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_requisition" model="ir.actions.act_window">
        <field name="name">Requisitions</field>
        <field name="res_model">utange.requisition</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No requisitions waiting</p>
            <p>Cashiers send requisitions from the Utange handheld (Requests tab). Approve them here to create the store transfer.</p>
        </field>
    </record>
</odoo>
