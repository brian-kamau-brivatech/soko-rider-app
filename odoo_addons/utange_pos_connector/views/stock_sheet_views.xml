<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_sheet_tree" model="ir.ui.view">
        <field name="name">utange.stock.sheet.tree</field>
        <field name="model">utange.stock.sheet</field>
        <field name="arch" type="xml">
            <tree decoration-danger="close_diff_count &gt; 0" decoration-muted="state == 'closed' and close_diff_count == 0">
                <field name="name"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="open_date"/>
                <field name="close_date"/>
                <field name="open_employee_id"/>
                <field name="close_employee_id" optional="show"/>
                <field name="open_diff_count" string="Opening diffs"/>
                <field name="close_diff_count" string="Closing diffs"/>
                <field name="close_diff_value" sum="Variance"/>
                <field name="open_approval" widget="badge" optional="show" decoration-warning="open_approval == 'pending'"
                       decoration-success="open_approval == 'approved'" decoration-danger="open_approval == 'rejected'"/>
                <field name="close_approval" widget="badge" optional="show" decoration-warning="close_approval == 'pending'"
                       decoration-success="close_approval == 'approved'" decoration-danger="close_approval == 'rejected'"/>
                <field name="amount_total" sum="Sales"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'open'"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_sheet_form" model="ir.ui.view">
        <field name="name">utange.stock.sheet.form</field>
        <field name="model">utange.stock.sheet</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_confirm_open" type="object" string="Confirm opening count" class="btn-primary"
                            invisible="state != 'draft'" confirm="Confirm the opening stock as counted? The shift can then be opened (Odoo POS or handheld)."/>
                    <button name="action_start_close" type="object" string="Start closing count" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_confirm_close" type="object" string="Confirm closing count" class="btn-primary"
                            invisible="state != 'closing' or close_confirmed" confirm="Confirm the closing stock as counted? Differences are sent to the managers."/>
                    <button name="action_reopen_close_count" type="object" string="Recount" invisible="state != 'closing' or not close_confirmed"/>
                    <button name="action_refresh" type="object" string="Refresh sales and transfers" invisible="state not in ('open', 'closing')"/>
                    <button name="action_approve_open" type="object" string="Approve opening differences" class="btn-success"
                            invisible="open_approval != 'pending'" groups="point_of_sale.group_pos_manager"
                            confirm="Approve? Odoo's stock is corrected to the opening count."/>
                    <button name="action_reject_open" type="object" string="Reject opening differences"
                            invisible="open_approval != 'pending'" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_approve_close" type="object" string="Approve closing differences" class="btn-success"
                            invisible="close_approval != 'pending'" groups="point_of_sale.group_pos_manager"
                            confirm="Approve? Odoo's stock is corrected to the closing count."/>
                    <button name="action_reject_close" type="object" string="Reject closing differences"
                            invisible="close_approval != 'pending'" groups="point_of_sale.group_pos_manager"/>
                    <button name="action_print" type="object" string="Print"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Opening count: type what is really on the shelf in <b>Opening</b> (it starts with the system figure), then <b>Confirm opening count</b>.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'closing' or close_confirmed">
                        Closing count: type what is left in <b>Closing</b> (it starts with the expected figure), then <b>Confirm closing count</b>.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="open_approval != 'pending' and close_approval != 'pending'">
                        Count differences are waiting for a manager. Approving corrects Odoo's stock to the count;
                        rejecting keeps Odoo's stock and leaves the difference on this shift.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not opened_outside">
                        The session was opened without a count on the handheld: the opening figures are worked out by Odoo.
                    </div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="location_id"/>
                            <field name="opened_outside" invisible="1"/>
                            <field name="close_confirmed" invisible="1"/>
                        </group>
                        <group>
                            <field name="open_date"/>
                            <field name="open_employee_id"/>
                            <field name="close_date"/>
                            <field name="close_employee_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="open_diff_count"/>
                            <field name="open_approval"/>
                            <field name="open_approved_by" invisible="not open_approved_by"/>
                            <field name="open_reason" invisible="not open_reason"/>
                            <field name="close_diff_count"/>
                            <field name="close_approval"/>
                            <field name="close_approved_by" invisible="not close_approved_by"/>
                            <field name="close_reason" invisible="not close_reason"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="close_diff_value"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock sheet" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom" create="false" delete="false" decoration-danger="closed and close_diff &lt; 0" decoration-warning="open_diff != 0">
                                    <field name="product_id"/>
                                    <field name="point" string="Stock" optional="show"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="system_open" string="System" optional="show"/>
                                    <field name="counted_open" string="Opening" readonly="parent.state != 'draft'"/>
                                    <field name="open_diff" string="Open diff" optional="show"/>
                                    <field name="received" string="In"/>
                                    <field name="sent_out" string="Out" optional="show"/>
                                    <field name="sold" string="Sold"/>
                                    <field name="expected_close" string="Expected"/>
                                    <field name="counted_close" string="Closing" readonly="parent.state != 'closing' or parent.close_confirmed"/>
                                    <field name="close_diff" string="Diff"/>
                                    <field name="price" string="Price"/>
                                    <field name="amount" string="Amount" sum="Total"/>
                                    <field name="closed" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_stock_sheet_search" model="ir.ui.view">
        <field name="name">utange.stock.sheet.search</field>
        <field name="model">utange.stock.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="open_employee_id"/>
                <filter name="open" string="Open shifts" domain="[('state', '=', 'open')]"/>
                <filter name="variance" string="With closing differences" domain="[('close_diff_count', '&gt;', 0)]"/>
                <filter name="to_approve" string="Waiting for manager" domain="['|', ('open_approval', '=', 'pending'), ('close_approval', '=', 'pending')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('open_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="by_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'open_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_sheet" model="ir.actions.act_window">
        <field name="name">Shift stock sheets</field>
        <field name="res_model">utange.stock.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock sheets yet</p>
            <p>A stock sheet is made when a cashier opens a shift on the Utange handheld and counts the stock.</p>
        </field>
    </record>

    <record id="view_sheet_line_tree" model="ir.ui.view">
        <field name="name">utange.stock.sheet.line.tree</field>
        <field name="model">utange.stock.sheet.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="sheet_id"/>
                <field name="product_id"/>
                <field name="counted_open" string="Opening"/>
                <field name="received" string="In"/>
                <field name="sold" sum="Sold"/>
                <field name="expected_close" string="Expected"/>
                <field name="counted_close" string="Closing"/>
                <field name="close_diff" string="Diff" sum="Diff"/>
                <field name="amount" sum="Amount"/>
            </tree>
        </field>
    </record>

    <record id="action_sheet_variances" model="ir.actions.act_window">
        <field name="name">Stock variances</field>
        <field name="res_model">utange.stock.sheet.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('closed', '=', True), ('close_diff', '!=', 0)]</field>
        <field name="context">{'group_by': 'product_id'}</field>
    </record>

    <record id="action_sheet_to_approve" model="ir.actions.act_window">
        <field name="name">Counts to approve</field>
        <field name="res_model">utange.stock.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>
</odoo>
